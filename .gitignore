# Secrets / environment
.env
.env.*
!.env.example
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments (matches at any depth)
venv/
venv*/
.venv/
env/

# OS files
.DS_Store

# Gradio
.gradio/

# Model artifacts / checkpoints (large binaries, match at any depth)
bert-mini-finetuned/
checkpoint-*/
tmp_trainer/
*.safetensors
*.pt
*.pth
*.bin

# Vector stores
vectorstore_gemini/
*.faiss
*.pkl
# ...except the OpenAI index (1.3 MB), committed so a deployment can load it
# instead of re-embedding every PDF on each cold start. This negation has to
# follow the *.faiss / *.pkl rules above to override them.
!vectorstore_openai/
!vectorstore_openai/**

# Large data / generated outputs (kept locally, not committed)
outputs/metrics.csv
outputs/batch_results_*.csv
outputs/merged_dataset.csv
logs/

# Generated metrics / eval artifacts (regenerated at runtime, not needed in the repo)
outputs/*.csv
outputs/*.json
outputs/*.xlsx
metrics_log/
